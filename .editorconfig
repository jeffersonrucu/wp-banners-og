root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.php]
indent_style = tab

[*.{js,json,yml,yaml,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.min.js]
insert_final_newline = false
trim_trailing_whitespace = false
