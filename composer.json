{
    "name": "jeffersonrucu/banners-og",
    "description": "Open Graph banners (1200x630) rendered in the browser and published as the WordPress og:image.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "plugin",
        "open-graph",
        "og-image",
        "social",
        "html2canvas"
    ],
    "authors": [
        {
            "name": "Jefferson Oliveira",
            "homepage": "https://github.com/jeffersonrucu"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "composer/installers": "^2.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-stubs/wordpress-stubs": "^6.9",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.2"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "banners-og"
    },
    "scripts": {
        "lint": "@php -l banners-og.php",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "check-version": "@php bin/check-version.php",
        "dist": "bin/build-dist.sh"
    }
}
